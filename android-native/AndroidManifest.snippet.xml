<!-- Add these inside <activity android:name=".MainActivity"> in android/app/src/main/AndroidManifest.xml
     so SK Coder appears in "Open with" for code files. -->

<!-- Open code/text files from any file manager -->
<intent-filter android:label="@string/app_name">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="file" />
    <data android:scheme="content" />
    <data android:mimeType="text/*" />
    <data android:mimeType="application/json" />
    <data android:mimeType="application/javascript" />
    <data android:mimeType="application/x-sh" />
    <data android:mimeType="application/xml" />
</intent-filter>

<!-- Open by extension (some file managers send octet-stream) -->
<intent-filter android:label="@string/app_name">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="file" />
    <data android:scheme="content" />
    <data android:mimeType="*/*" />
    <data android:pathPattern=".*\\.html" />
    <data android:pathPattern=".*\\.css" />
    <data android:pathPattern=".*\\.js" />
    <data android:pathPattern=".*\\.ts" />
    <data android:pathPattern=".*\\.jsx" />
    <data android:pathPattern=".*\\.tsx" />
    <data android:pathPattern=".*\\.py" />
    <data android:pathPattern=".*\\.cpp" />
    <data android:pathPattern=".*\\.c" />
    <data android:pathPattern=".*\\.java" />
    <data android:pathPattern=".*\\.go" />
    <data android:pathPattern=".*\\.rs" />
    <data android:pathPattern=".*\\.php" />
    <data android:pathPattern=".*\\.rb" />
    <data android:pathPattern=".*\\.json" />
    <data android:pathPattern=".*\\.md" />
    <data android:pathPattern=".*\\.sh" />
</intent-filter>

<!-- Add this <queries> block at the root of AndroidManifest.xml (sibling of <application>)
     so SK Coder can detect/launch Termux on Android 11+. -->
<queries>
    <package android:name="com.termux" />
    <package android:name="com.termux.api" />
</queries>
